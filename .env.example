# Copy to .env and fill in. .env is git-ignored.
ENTSOE_TOKEN=put-your-token-here

# Optional overrides. Defaults (config.py) are the host addresses; the dev container sets
# mongodb://mongo:27017 and kafka:9092. Uncomment only if you need a different address.
# MONGO_URI=mongodb://localhost:27017
MONGO_DB=free_power_hours
# KAFKA_BOOTSTRAP=localhost:9094
