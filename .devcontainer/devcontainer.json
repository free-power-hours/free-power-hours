{
  "name": "Free Power Hours",
  // All services are defined once in the top-level docker-compose.yml.
  "dockerComposeFile": "../docker-compose.yml",
  "service": "app",
  "runServices": ["app", "mongo", "kafka", "kafka-ui"],
  "workspaceFolder": "/workspaces/free-power-hours",
  "shutdownAction": "stopCompose",

  "features": {
    // Java is required by PySpark (Spark runs on the JVM).
    "ghcr.io/devcontainers/features/java:1": { "version": "17" }
  },

  // Runs once after the container is created.
  "postCreateCommand": "pip install --user --no-warn-script-location -r requirements.txt && { [ -f .env ] || cp .env.example .env; }",

  // pip --user installs CLI tools (jupyter, ...) here.
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin"
  },

  // MongoDB (27017), Kafka (9094) and Kafka UI (8080) are published by docker-compose.yml.
  "forwardPorts": [4040],
  "portsAttributes": {
    "4040": { "label": "Spark UI", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "mongodb.mongodb-vscode"
      ],
      "settings": {
        // Use the container's Python, not a host .venv that may be in the workspace.
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.terminal.activateEnvironment": false,
        "jupyter.notebookFileRoot": "${fileDirname}",
        "files.eol": "\n"
      }
    }
  }
}
